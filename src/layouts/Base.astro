---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import { PROFILES, SITE_LANG, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	publishedTime?: Date;
	/** The homepage's own H1 is the name, so it suppresses the wordmark. */
	hideWordmark?: boolean;
	/** Overrides the document language. Set by pages whose body is not English. */
	lang?: string;
}

const {
	title,
	description,
	image,
	type,
	publishedTime,
	hideWordmark = false,
	lang = SITE_LANG,
} = Astro.props;
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedTime={publishedTime}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header shell">
			{
				hideWordmark ? (
					<span class="wordmark-placeholder" aria-hidden="true"></span>
				) : (
					<a class="wordmark" href="/">
						{SITE_TITLE}
					</a>
				)
			}
			<Nav />
		</header>

		<main id="main" class="shell">
			<slot />
		</main>

		<footer class="site-footer shell">
			<p>&copy; {year} {SITE_TITLE}</p>
			<nav aria-label="Footer">
				<ul>
					<li><a href="/writing/">Writing</a></li>
					<li><a href="/projects/">Projects</a></li>
					<li><a href="/books/">Books</a></li>
					<li><a href="/about/">About</a></li>
					{
						PROFILES.map((p) => (
							<li>
								<a href={p.href} rel="me noopener">
									{p.label}
								</a>
							</li>
						))
					}
					<li><a href="/rss.xml">RSS</a></li>
				</ul>
			</nav>
		</footer>

		<style>
			.wordmark-placeholder {
				display: block;
			}
		</style>
	</body>
</html>
