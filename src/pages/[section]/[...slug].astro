---
import { type CollectionEntry, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { GENERIC_SECTIONS, SECTION_LABELS, type WritingSection } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getPublished, getTranslations } from '../../lib/content';

/** Generates nothing today; every one of these four collections is empty. */
export async function getStaticPaths() {
	const paths = [];
	for (const section of GENERIC_SECTIONS) {
		for (const entry of await getPublished(section)) {
			paths.push({ params: { section, slug: entry.id }, props: { section, entry } });
		}
	}
	return paths;
}

interface Props {
	section: WritingSection;
	entry: CollectionEntry<WritingSection>;
}

const { section, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// `books` is the one collection with an extra required field. Narrowed rather
// than cast, so adding a field to another collection cannot silently break it.
const bookAuthor = 'bookAuthor' in data ? data.bookAuthor : undefined;

// Recovered posts carry the snapshot they were rescued from.
const sourceArchive = 'sourceArchive' in data ? data.sourceArchive : undefined;
const source = 'source' in data ? data.source : undefined;

// Old enough that reading it as current advice would be a mistake, so the age
// is stated plainly rather than left for the reader to infer from the date.
const age = new Date().getUTCFullYear() - data.date.getUTCFullYear();
// Only technical writing goes stale this way. A 2017 essay on Plotinus is not
// out of date, so the notice is scoped to the tech collection.
const isDated = section === 'tech' && age >= 5;

// Essay fields. Absent on collections that do not spread `essay`.
const lang = 'lang' in data ? data.lang : undefined;
const translation = 'translation' in data ? data.translation : undefined;
const prize = 'prize' in data ? data.prize : undefined;
const venue = 'venue' in data ? data.venue : undefined;
const composer = 'composer' in data ? data.composer : undefined;

const otherLanguages = await getTranslations(section, entry);

const LANGUAGE_NAMES: Record<string, string> = { es: 'Español', en: 'English' };
---

<Base
	title={data.title}
	description={data.summary}
	type="article"
	publishedTime={data.date}
	lang={lang}
>
	<article>
		<header class="head">
			<p class="back"><a href={`/${section}/`}>← {SECTION_LABELS[section]}</a></p>
			<h1>{data.title}</h1>
			{bookAuthor && <p class="byline">{bookAuthor}</p>}
			<p class="meta">
				<FormattedDate date={data.date} />
				{composer && <span class="dot">·</span>}
				{composer && <span>{composer}</span>}
			</p>

			{
				(prize || venue) && (
					<p class="credit">
						{prize && <strong>{prize}</strong>}
						{prize && venue && <span class="dot">·</span>}
						{venue}
					</p>
				)
			}

			{
				otherLanguages.length > 0 && (
					<p class="langs">
						{otherLanguages.map((t) => (
							<a href={t.href} hreflang={t.lang} lang={t.lang} rel="alternate">
								Read in {LANGUAGE_NAMES[t.lang] ?? t.lang}
							</a>
						))}
					</p>
				)
			}
			<p class="summary">{data.summary}</p>
		</header>

		{
			(isDated || sourceArchive || translation) && (
				<aside class="provenance" aria-label="About this article">
					{translation && (
						<p>
							<strong>This is a translation.</strong> The original was written in{' '}
							{LANGUAGE_NAMES[translation.from] ?? translation.from} by David Elizondo;
							this English version was produced by {translation.by} and has
							{translation.reviewed ? ' been reviewed by him' : ' not been reviewed by him'}.
						</p>
					)}
					{isDated && (
						<p>
							Written {age} years ago and kept as published. The versions and APIs it
							describes have moved on since.
						</p>
					)}
					{sourceArchive && (
						<p>
							First published on {source ? new URL(source).hostname : 'a site'}, which no longer
							exists. Recovered from the{' '}
							<a href={sourceArchive} rel="nofollow noopener">Internet Archive</a>.
						</p>
					)}
				</aside>
			)
		}

		<div class="prose">
			<Content />
		</div>
	</article>
</Base>

<style>
	.head {
		display: grid;
		grid-template-columns: 1fr min(var(--measure), 100%) 1fr;
		margin-block-end: var(--space-xl);
	}

	.head > * {
		grid-column: 2;
	}

	.back {
		font-size: var(--text-sm);
		margin-block-end: var(--space-lg);
	}

	.back a {
		color: var(--graphite);
		text-decoration: none;
	}

	.back a:hover {
		color: var(--carbon);
	}

	.byline {
		margin-block-start: var(--space-xs);
		font-family: var(--font-display);
		color: var(--graphite);
	}

	.meta {
		margin-block-start: var(--space-sm);
		font-size: var(--text-sm);
		color: var(--graphite);
	}

	/* Sits on the reading measure, quieter than the prose it precedes. */
	.provenance {
		max-width: var(--measure);
		margin-inline: auto;
		margin-block-end: var(--space-xl);
		padding: var(--space-sm) var(--space-md);
		border-inline-start: 2px solid var(--rule);
		font-size: var(--text-sm);
		color: var(--graphite);
	}

	.provenance p + p {
		margin-block-start: var(--space-2xs);
	}

	.credit {
		margin-block-start: var(--space-xs);
		font-size: var(--text-sm);
		color: var(--graphite);
	}

	.dot {
		color: var(--rule);
		margin-inline: 0.4ch;
	}

	.langs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
		margin-block-start: var(--space-sm);
		font-size: var(--text-sm);
	}

	.summary {
		margin-block-start: var(--space-md);
		font-size: var(--text-lg);
		color: var(--graphite);
		text-wrap: pretty;
	}
</style>
