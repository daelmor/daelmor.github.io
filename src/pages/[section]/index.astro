---
import WritingList from '../../components/WritingList.astro';
import { GENERIC_SECTIONS, SECTION_LABELS, type WritingSection } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getSectionGroups } from '../../lib/content';

/**
 * Category index for the writing sections other than `books`, which has its own
 * route. `projects` is bespoke too. The unified list lives at /writing/.
 */
export async function getStaticPaths() {
	return GENERIC_SECTIONS.map((section) => ({ params: { section }, props: { section } }));
}

interface Props {
	section: WritingSection;
}

const { section } = Astro.props;
const label = SECTION_LABELS[section];

// Grouped by work, so a bilingual essay is one row offering two languages.
const groups = await getSectionGroups(section);
---

<Base title={label}>
	<h1>Writing: {label}</h1>
	<WritingList groups={groups} current={section as 'tech' | 'philosophy' | 'music'} />
</Base>
