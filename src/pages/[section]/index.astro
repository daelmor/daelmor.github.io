---
import FormattedDate from '../../components/FormattedDate.astro';
import { GENERIC_SECTIONS, SECTION_LABELS, type WritingSection } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getSectionGroups } from '../../lib/content';

/**
 * Index for every section except `projects` and `books`, which have their own
 * routes — one for engagement spans, the other for a cover grid.
 */
export async function getStaticPaths() {
	return GENERIC_SECTIONS.map((section) => ({ params: { section }, props: { section } }));
}

interface Props {
	section: WritingSection;
}

const { section } = Astro.props;
const label = SECTION_LABELS[section];

// Grouped by work, so a bilingual essay is one row offering two languages
// rather than two rows a reader has to notice are the same piece.
const groups = await getSectionGroups(section);

const LANGUAGE_NAMES: Record<string, string> = { es: 'Español', en: 'English' };
---

<Base title={label}>
	<h1>{label}</h1>

	{
		groups.length === 0 ? (
			<p class="empty">Nothing here yet.</p>
		) : (
			<ul class="list">
				{groups.map(({ primary, versions, crossListed }) => {
					const lang = 'lang' in primary.data ? primary.data.lang : undefined;
					const prize = 'prize' in primary.data ? primary.data.prize : undefined;
					const translations = versions.filter((v) => !v.isOriginal);
					return (
						<li>
							<a class="row" href={primary.href} hreflang={lang}>
								<span class="row-title" lang={lang}>
									{primary.data.title}
								</span>
								<span class="row-date">
									<FormattedDate date={primary.data.date} monthOnly />
								</span>
							</a>

							<p class="row-summary" lang={lang}>
								{primary.data.summary}
							</p>

							<p class="row-meta">
								{prize && <span class="badge badge-prize">{prize}</span>}
								{crossListed && (
									<span class="badge">in {SECTION_LABELS[primary.collection]}</span>
								)}
								{versions.length > 1 &&
									versions.map((v) => (
										<a class="lang" href={v.href} hreflang={v.lang} lang={v.lang}>
											{LANGUAGE_NAMES[v.lang] ?? v.lang}
											{v.isOriginal && <span class="orig"> · original</span>}
										</a>
									))}
								{versions.length === 1 && lang === 'es' && translations.length === 0 && (
									<span class="badge">Español only</span>
								)}
							</p>
						</li>
					);
				})}
			</ul>
		)
	}
</Base>

<style>
	.empty {
		margin-block-start: var(--space-lg);
		color: var(--graphite);
	}

	.list {
		list-style: none;
		margin-block-start: var(--space-xl);
		padding: 0;
		max-width: var(--measure);
	}

	.list li + li {
		margin-block-start: var(--space-lg);
		padding-block-start: var(--space-lg);
		border-block-start: 1px solid var(--rule);
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem var(--space-md);
		color: inherit;
		text-decoration: none;
	}

	.row-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-lg);
		letter-spacing: -0.01em;
		max-width: 44ch;
		text-wrap: pretty;
	}

	.row:hover .row-title {
		color: var(--carbon);
	}

	.row-date {
		font-size: var(--text-sm);
		color: var(--graphite);
		white-space: nowrap;
	}

	.row-summary {
		margin-block-start: var(--space-xs);
		color: var(--graphite);
		text-wrap: pretty;
	}

	.row-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-xs) var(--space-md);
		margin-block-start: var(--space-sm);
		font-size: var(--text-sm);
	}

	/* The language choices are the point of this row, so they read as links
	   rather than as quiet metadata. */
	.lang {
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.orig {
		color: var(--graphite);
		font-size: var(--text-xs);
	}

	.badge {
		font-size: var(--text-xs);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--graphite);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		padding: 0.1em 0.4em;
	}

	.badge-prize {
		color: var(--ink);
		border-color: var(--ink);
	}
</style>
