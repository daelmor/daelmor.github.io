---
import Base from '../../layouts/Base.astro';
import { entryPath, getPublished } from '../../lib/content';

/**
 * The books index, which needs its own route rather than the generic section
 * listing: 78 entries with covers want a grid, and they group by shelf rather
 * than running in one date-sorted column.
 */
const books = await getPublished('books');

const SHELVES = [
	{
		key: 'currently-reading' as const,
		label: 'Reading now',
		note: 'Open at the moment, or open often.',
	},
	{ key: 'read' as const, label: 'Read', note: null },
	{ key: 'to-read' as const, label: 'Next', note: null },
];

const grouped = SHELVES.map((shelf) => ({
	...shelf,
	items: books.filter((b) => b.data.shelf === shelf.key),
})).filter((group) => group.items.length > 0);

const total = books.length;
---

<Base
	title="Books"
	description={`${total} books across three shelves, with covers and publisher synopses.`}
>
	<h1>Books</h1>

	{
		total === 0 ? (
			<p class="empty">Nothing here yet.</p>
		) : (
			<>
				<p class="lede">
					{total} books, kept in step with{' '}
					<a href="https://www.goodreads.com/user/show/35915255" rel="me noopener">
						my Goodreads shelves
					</a>
					.
				</p>

				{grouped.map((group) => (
					<details class="shelf" open={group.key !== 'read'}>
						<summary id={`shelf-${group.key}`}>
							<h2>{group.label}</h2>
							<span class="count">{group.items.length}</span>
						</summary>
						{group.note && <p class="shelf-note">{group.note}</p>}

						<ul class="books">
							{group.items.map(({ id, data }) => (
								<li>
									<a class="book-title" href={entryPath('books', id)}>
										{data.title}
									</a>
									<span class="book-meta">
										{data.bookAuthor}
										{data.published !== undefined &&
											` · ${data.published < 0 ? `${Math.abs(data.published)} BC` : data.published}`}
										{data.rating !== undefined && (
											<>
												{' · '}
												<span aria-hidden="true">{'★'.repeat(data.rating)}</span>
												<span class="visually-hidden">rated {data.rating} out of 5</span>
											</>
										)}
									</span>
								</li>
							))}
						</ul>
					</details>
				))}
			</>
		)
	}
</Base>

<style>
	.empty,
	.lede {
		margin-block-start: var(--space-md);
		color: var(--graphite);
	}

	.lede {
		max-width: var(--measure);
	}

	.shelf {
		margin-block-start: var(--space-xl);
		max-width: var(--measure);
	}

	.shelf summary {
		display: flex;
		align-items: baseline;
		gap: var(--space-xs);
		cursor: pointer;
	}

	.shelf h2 {
		display: inline;
	}

	.count {
		font-family: var(--font-ui);
		font-size: var(--text-xs);
		color: var(--graphite);
	}

	.shelf-note {
		margin-block-start: var(--space-xs);
		font-size: var(--text-sm);
		color: var(--graphite);
	}

	.books {
		list-style: none;
		margin-block-start: var(--space-md);
		padding: 0;
	}

	.books li {
		padding-block: var(--space-xs);
	}

	.book-title {
		color: var(--ink);
		text-decoration: none;
		text-wrap: pretty;
	}

	.book-title:hover {
		color: var(--carbon);
	}

	.book-meta {
		display: block;
		font-family: var(--font-ui);
		font-size: var(--text-xs);
		color: var(--graphite);
	}
</style>
