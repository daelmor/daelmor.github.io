---
import WorkList from '../../components/WorkList.astro';
import Base from '../../layouts/Base.astro';
import { getPublished } from '../../lib/content';

const projects = await getPublished('projects');
---

<Base title="Projects" description="Selected professional work and engineering case studies.">
	<h1>Selected Work</h1>
	<p class="lede">
		Engagements are listed newest first by start date. Each has its own dates, and some
		overlapped.
	</p>
	{projects.length === 0 ? <p>No entries yet.</p> : <WorkList projects={projects} />}
</Base>

<style>
	.lede {
		margin-block: var(--space-sm) var(--space-xl);
		color: var(--graphite);
		max-width: var(--measure);
	}
</style>
