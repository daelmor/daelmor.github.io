---
import { Image } from 'astro:assets';
import { type CollectionEntry, render } from 'astro:content';
import ProjectPeriod from '../../components/ProjectPeriod.astro';
import Base from '../../layouts/Base.astro';
import { getPublished } from '../../lib/content';

export async function getStaticPaths() {
	const projects = await getPublished('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Base
	title={`${data.company}: ${data.title}`}
	description={data.summary}
	image={data.hero}
	type="article"
	publishedTime={data.date}
>
	<article>
		<header class="head">
			<p class="back"><a href="/projects/">← Projects</a></p>

			<p class="company">{data.company}</p>
			<h1>{data.title}</h1>
			<p class="summary">{data.summary}</p>

			<dl class="facts">
				<dt>Role</dt>
				<dd>{data.role}</dd>

				<dt>Span</dt>
				<dd><ProjectPeriod start={data.date} end={data.end} /></dd>

				<dt>Stack</dt>
				<dd>
					<ul class="stack">
						{data.tech.map((item) => <li>{item}</li>)}
					</ul>
				</dd>
			</dl>
		</header>

		<figure class="hero">
			{/* Eager and high priority: this is the page's LCP element, and
			    Astro's <Image> defaults to lazy, which delays it needlessly. */}
			<Image
				src={data.hero}
				alt={data.heroAlt}
				widths={[640, 960, 1440]}
				sizes="(min-width: 60rem) 56rem, 100vw"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>

		<div class="prose">
			<Content />
		</div>
	</article>
</Base>

<style>
	.head {
		display: grid;
		grid-template-columns: 1fr min(var(--measure), 100%) 1fr;
	}

	.head > * {
		grid-column: 2;
	}

	.back {
		font-size: var(--text-sm);
		margin-block-end: var(--space-lg);
	}

	.back a {
		color: var(--graphite);
		text-decoration: none;
	}

	.back a:hover {
		color: var(--carbon);
	}

	.company {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--graphite);
		margin-block-end: var(--space-xs);
	}

	.summary {
		margin-block-start: var(--space-md);
		font-size: var(--text-lg);
		color: var(--graphite);
		text-wrap: pretty;
	}

	/*
	 * A definition list with generous leading, not a ruled table. One rule above
	 * it and nothing else — the aim is an aligned record, not a grid of boxes.
	 */
	.facts {
		margin-block-start: var(--space-lg);
		padding-block-start: var(--space-md);
		border-block-start: 1px solid var(--rule);
		display: grid;
		gap: var(--space-xs) var(--space-md);
		font-size: var(--text-sm);
	}

	.facts dt {
		color: var(--graphite);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding-block-start: 0.15em;
	}

	.facts dd {
		margin: 0;
	}

	.stack {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.75rem;
	}

	.stack li + li::before {
		content: '·';
		color: var(--rule);
		margin-inline-end: 0.75rem;
	}

	.hero {
		margin-block: var(--space-xl);
	}

	.hero img {
		width: 100%;
		max-height: 34rem;
		object-fit: cover;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--sheet-raised);
	}

	@media (min-width: 40rem) {
		.facts {
			grid-template-columns: 5.5rem 1fr;
			align-items: start;
		}
	}
</style>
