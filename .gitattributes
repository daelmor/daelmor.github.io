# Normalise line endings so the repo is identical on Windows and on the
# Ubuntu runner that builds it. Without this, every file committed from
# Windows lands with CRLF and shows up as fully rewritten in later diffs.
* text=auto eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated; collapse it in review.
package-lock.json linguist-generated=true -diff
